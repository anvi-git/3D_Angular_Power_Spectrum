using LoopVectorization

function compute_T̃_beyond_turbo(ℓ::Number, χ::AbstractArray, R::AbstractArray,  
                                 kp::AbstractArray, kpp::AbstractArray, 
                                 kmin::Number, kmax::Number, β::Number;  
                                 n_cheb::Int = 119, N::Int = 2^(15)+1)
    nχ = length(χ)
    nR = length(R)
    nkp = length(kp)
    nkpp = length(kpp)

    x = Blast.get_clencurt_grid(kmin, kmax, N)
    w = Blast.get_clencurt_weights(kmin, kmax, N)
    T, Bessel_k = Blast.bessel_cheb_eval(ℓ, kmin, kmax, χ, n_cheb, N)

    T_tilde = zeros(nχ, nR, nkp, nkpp, n_cheb+1)
    
    # Pre-calculate alpha weight vector
    α = w .* (x .^ β)

    # 1. Pre-allocate and pre-compute transcendental Bessel grids
    # This exposes raw arrays to LoopVectorization, bypassing function call overhead.
    Bessel_k_χ2_grid = zeros(nχ, nR, N)
    for i in 1:nχ
        for ridx in 1:nR
            χ₂ = χ[i] / R[ridx]
            for n in 1:N
                Bessel_k_χ2_grid[i, ridx, n] = sphericalbesselj(ℓ, x[n] * χ₂)
            end
        end
    end

    bessel_kp_χ1_grid = zeros(nχ, nkp)
    bessel_kpp_χ2_grid = zeros(nχ, nR, nkpp)
    
    for i in 1:nχ
        χ₁ = χ[i]
        for kpi in 1:nkp
            bessel_kp_χ1_grid[i, kpi] = sphericalbesselj(ℓ, kp[kpi] * χ₁)
        end
        for ridx in 1:nR
            χ₂ = χ₁ / R[ridx]
            for kppi in 1:nkpp
                bessel_kpp_χ2_grid[i, ridx, kppi] = sphericalbesselj(ℓ, kpp[kppi] * χ₂)
            end
        end
    end

    # 2. Use @tturbo to parallelize and SIMD-vectorize the massive contraction loop
    # LoopVectorization will automatically handle smart multi-threading and cash reuse.
    @tturbo for l in 1:n_cheb+1
        for kppi in 1:nkpp
            for kpi in 1:nkp
                for ridx in 1:nR
                    for i in 1:nχ
                        integral = 0.0
                        for n in 1:N
                            integral += α[n] * T[l, n] * Bessel_k[i, n] * Bessel_k_χ2_grid[i, ridx, n]
                        end
                        # Combine the pre-computed external factors
                        T_tilde[i, ridx, kpi, kppi, l] = integral * bessel_kp_χ1_grid[i, kpi] * bessel_kpp_χ2_grid[i, ridx, kppi]
                    end
                end
            end
        end
    end

    return T_tilde
end




