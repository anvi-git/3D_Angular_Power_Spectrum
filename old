function compute_T̃_beyond_fast(ℓ::Number, χ::AbstractArray, R::AbstractArray,  
                               kp::AbstractArray, kpp::AbstractArray, 
                               kmin::Number, kmax::Number, β::Number;  
                               n_cheb::Int = 119, N::Int = 2^(15)+1)
    nχ = length(χ)
    nR = length(R)
    nkp = length(kp)
    nkpp = length(kpp)

    x = Blast.get_clencurt_grid(kmin, kmax, N)
    w = Blast.get_clencurt_weights(kmin, kmax, N)
    T, Bessel_k = Blast.bessel_cheb_eval(ℓ, kmin, kmax, χ, n_cheb, N)

    T_tilde = zeros(nχ, nR, nkp, nkpp, n_cheb+1)
    α = w .* (x .^ β)

    # 1. Thread the outermost loop only
    Threads.@threads for i in 1:nχ
        # Allocating thread-local buffers to prevent data races
        Bessel_k_χ2 = zeros(N) 
        
        for ridx in 1:nR
            χ₁ = χ[i]
            χ₂ = χ₁ / R[ridx]
            Bessel_k_χ1 = @views Bessel_k[i, :]

            # 2. No threading here; serial execution is faster for math functions
            for n in 1:N
                Bessel_k_χ2[n] = sphericalbesselj(ℓ, x[n] * χ₂)
            end

            for kpi in 1:nkp, kppi in 1:nkpp
                bessel_kp_χ1 = sphericalbesselj(ℓ, kp[kpi] * χ₁)
                bessel_kpp_χ2 = sphericalbesselj(ℓ, kpp[kppi] * χ₂)

                # 3. Pull independent constants out of the innermost integration loop
                const_factor = bessel_kp_χ1 * bessel_kpp_χ2

                for l in 1:n_cheb+1
                    integral = 0.0
                    # 4. Use SIMD vectorization for the reduction math
                    @simd for n in 1:N
                        integral += α[n] * T[l, n] * Bessel_k_χ1[n] * Bessel_k_χ2[n]
                    end
                    T_tilde[i, ridx, kpi, kppi, l] = integral * const_factor
                end
            end
        end
    end

    return T_tilde
end



