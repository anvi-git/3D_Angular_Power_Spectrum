function compute_T̃_beyond(ℓ, χ, R, kp, kpp, kmin, kmax, β; n_cheb=119, N=2^15+1)
    nχ, nR, nkp, nkpp = length(χ), length(R), length(kp), length(kpp)
    x  = Blast.get_clencurt_grid(kmin, kmax, N)
    w  = Blast.get_clencurt_weights(kmin, kmax, N)
    T, Bessel_k = Blast.bessel_cheb_eval(ℓ, kmin, kmax, χ, n_cheb, N)
    α  = w .* x .^ β

    # Precompute all Bessel values outside integration
    Bχ2 = [sphericalbesselj(ℓ, x[n] * χ[i]/R[r]) for n in 1:N, i in 1:nχ, r in 1:nR]
    Bkp = [sphericalbesselj(ℓ, kp[j] * χ[i])     for i in 1:nχ, j in 1:nkp]
    Bkpp= [sphericalbesselj(ℓ, kpp[j] * χ[i]/R[r]) for i in 1:nχ, r in 1:nR, j in 1:nkpp]

    T_tilde = zeros(nχ, nR, nkp, nkpp, n_cheb+1)

    Threads.@threads for i in 1:nχ
        for r in 1:nR
            # Single BLAS gemv per (i,r): shape (n_cheb+1,)
            integrand = α .* @view(Bessel_k[i,:]) .* @view(Bχ2[:,i,r])
            cheb_proj = T * integrand  # (n_cheb+1,) via BLAS

            for kpi in 1:nkp, kppi in 1:nkpp
                scalar = Bkp[i,kpi] * Bkpp[i,r,kppi]
                @inbounds @views T_tilde[i, r, kpi, kppi, :] .= scalar .* cheb_proj
            end
        end
    end
    return T_tilde
end



